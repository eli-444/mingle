{
  "name": "mingle-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --env-file-if-exists=.env scripts/build-frontend.js",
    "start": "node --env-file-if-exists=.env scripts/start.js",
    "dev": "node --watch --env-file-if-exists=.env scripts/start.js",
    "test": "node --test --test-isolation=none test/server.test.js test/admin.test.js test/frontend.test.js test/supabase.test.js test/supabase-api.test.js test/transport.test.js",
    "test:e2e": "playwright test",
    "test:supabase": "node --test --test-isolation=none test/supabase.test.js test/supabase-api.test.js",
    "test:supabase:live": "node --env-file=.env scripts/test-supabase-live.js",
    "setup:admin": "node scripts/setup-admin.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "geoip-lite": "^2.0.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  }
}
