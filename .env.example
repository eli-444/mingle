PORT=3000
# URL publique exacte, sans slash final
PUBLIC_ORIGIN=https://chat.exemple.fr
# Relais coturn : même secret que static-auth-secret dans coturn.
TURN_URLS=turn:turn.exemple.fr:3478?transport=udp,turn:turn.exemple.fr:3478?transport=tcp
TURN_SECRET=
# true oblige la vidéo à passer par TURN et masque votre IP à l'autre visiteur.
RELAY_ONLY=false
# Activer uniquement derrière un proxy qui remplace X-Real-IP (exemple Caddy fourni).
TRUST_PROXY=false
# Générer les valeurs avec npm run setup:admin. Ne pas publier le fichier d'accès.
ADMIN_PATH=
ADMIN_PASSWORD_HASH=
DATA_FILE=./data/mingle.sqlite
